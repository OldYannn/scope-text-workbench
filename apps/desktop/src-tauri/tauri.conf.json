{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCOPE 文镜 (Development)",
  "version": "0.1.0",
  "identifier": "io.github.oldyannn.scope.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCOPE 文镜 — Milestone 1",
        "width": 1080,
        "height": 720,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/scope-engine-dev"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
